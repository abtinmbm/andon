/data/
/checkpoints/
*.wav
*.zip
*.zip.part
*.pt
*.npy
/results/*.lock

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Firmware build output, and real-model headers (weights trained on CC BY-NC-SA data,
